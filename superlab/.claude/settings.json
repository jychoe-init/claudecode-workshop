{
  "model": "opus",
  "permissions": {
    "allow": [
      "Bash(npm test *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Edit(CLAUDE.md)",
      "Edit(README.md)",
      "mcp__hr__get_*"
    ],
    "ask": [
      "Edit(reports/**)",
      "Bash(git push *)",
      "mcp__hr__request_*"
    ],
    "deny": [
      "Read(.env*)",
      "Edit(.env*)",
      "Edit(.claude/settings.json)",
      "Edit(.claude/settings.local.json)",
      "Edit(.gitignore)",
      "Bash(rm *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "WebFetch"
    ]
  },
  "sandbox": {
    "network": {
      "allowLocalBinding": true,
      "allowedDomains": [
        "*.cloudfront.net"
      ]
    }
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/post-check.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/tools/usage_log.sh"
          }
        ]
      }
    ]
  },
  "enabledMcpjsonServers": [
    "hr"
  ]
}
